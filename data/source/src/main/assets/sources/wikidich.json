{
  "id": "wikidich",
  "name": "WikiDich VN",
  "baseUrl": "https://wikidichvn.com",
  "hosts": ["wikidichvn.com"],
  "lang": "vi",
  "fetch": { "mode": "http" },
  "urls": {
    "chapter": "^https?://[^/]+/[a-z0-9-]+/chuong-\\d+[^/]*/?$",
    "book": "^https?://[^/]+/[a-z0-9-]+/?$"
  },
  "search": {
    "url": "{base}/tim-kiem?s={query}",
    "list": ".truyen-list .item",
    "title": "h3 a@text",
    "link": "h3 a@href",
    "author": "p.line:has(span:containsOwn(Tác giả)) a@text",
    "cover": "a.cover img@src"
  },
  "book": {
    "title": "h1[itemprop=name]@text",
    "author": "a[itemprop=author]@text",
    "cover": ".book-info-pic img@src",
    "description": "div[itemprop=description]@html",
    "status": ".label-status@text",
    "genres": ".li--genres a@text"
  },
  "toc": {
    "list": "#chapter-list li a",
    "pageList": "ul li a",
    "title": "@text",
    "link": "@href",
    "bookId": "input[name=bid]@value",
    "totalPages": ".paging a:last-child@onclick|regex:page\\(\\d+,\\s*(\\d+)\\)",
    "pageUrl": "{base}/get/listchap/{bookId}?page={page}",
    "pageJson": "data",
    "pageHeaders": { "X-Requested-With": "XMLHttpRequest" }
  },
  "chapter": {
    "title": "h2.current-chapter@text",
    "content": "div.truyen",
    "remove": ["script", "style", "iframe", "ins", "div[id*=ads]", ".ads"],
    "removeLines": ["wikidich", "^Nguồn:"],
    "bookUrl": "h1.current-book a@href",
    "prev": "a.back:not(.disabled)@href",
    "next": "a.next:not(.disabled)@href"
  }
}
